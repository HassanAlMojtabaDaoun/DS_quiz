{
  "name": "ds-storage-ui",
  "private": true,
  "version": "1.0.0",
  "description": "React web UI for the distributed object storage framework",
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --jsx=automatic --target=es2020 --define:process.env.NODE_ENV=\\\"production\\\" --outfile=dist/app.js && node scripts/copy-static.mjs",
    "dev": "esbuild src/main.jsx --bundle --jsx=automatic --sourcemap --outfile=dist/app.js --watch"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
