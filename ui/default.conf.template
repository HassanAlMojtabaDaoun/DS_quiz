# Serves the React app and forwards /api/* to the gateway, so the browser
# talks to a single origin (no CORS) and large uploads/downloads stream.
server {
    listen 80;
    client_max_body_size 0;                 # no upload size limit here

    location /api/ {
        proxy_pass http://${API_UPSTREAM}/;   # strips the /api prefix
        proxy_http_version 1.1;
        proxy_request_buffering off;        # stream uploads
        proxy_buffering off;                # stream downloads
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
